{%- import 'macros/fontawesome.twig' as fontawesome -%}
{%- set options = options|merge(site.links.buttons) -%}
{#- links are the block items (fallback to page links for backward compatibility) -#}
{%- set links = block.items|default(page.links|default([])) -%}
{#- unique prefix to allow several links blocks in the same page -#}
{%- set prefix = 'buttons-' ~ block_index|default(1) -%}
      {#- block links -#}
      {%- if links|length > 0 ~%}
        <ol id="{{ prefix }}" class="buttons">
          {%- for link in links ~%}
          <li>
            {#- background color (from link) + text color (auto contrast) -#}
            {%- set button_style = null -%}
            {%- if options.color|default('page') == 'page' and link.color|default -%}
              {%- set rgb = link.color|hex_to_rgb ~%}
            <style>{% apply minify_css ~%}
              :root {
                --{{ prefix }}-{{ loop.index }}-color: calc((((({{ rgb.red }} * 299) + ({{ rgb.green }} * 587) + ({{ rgb.blue }} * 114)) / 1000) - 128) * -1000);
              }
            {% endapply ~%}</style>
              {%- set button_style = ' style="border:0;background-color:' ~ link.color ~ ';color:rgb(var(--' ~ prefix ~ '-' ~ loop.index ~ '-color),var(--' ~ prefix ~ '-' ~ loop.index ~ '-color),var(--' ~ prefix ~ '-' ~ loop.index ~ '-color))"' ~%}
            {%- endif -%}
            {#- link ~#}
            <a id="{{ prefix }}-{{ loop.index }}"{% if link.url|default %} href="{{ link.url }}"{% endif %} target="_blank">
              {#- video -#}
              {%- if link.video|default ~%}
              <div class="button button-media">
                <video controls>
                  <source src="{{ asset(link.video) }}" type="{{ asset(link.video).subtype }}">
                </video>
                <div>{{ link.title|default }}</div>
              </div>
              {#- image -#}
              {%- elseif link.image|default ~%}
              <div class="button button-media">
                {{ html(
                  asset(link.image),
                  attributes={
                    alt: link.title|default,
                    fetchpriority: 'high'
                  },
                  options={
                    responsive: true,
                    formats: ['webp']
                  }
                ) }}
                <div>{{ link.title|default }}</div>
              </div>
              {#- button -#}
              {%- else ~%}
              <div class="button button-link"{{ button_style|default }}>
                {%- set website_image = null -%}
                {%- if link.icon|default ~%}
                <span class="button-icon">{{ fontawesome.icon(link.icon|default('solid:link')|split(':')[1], link.icon|default('solid:link')|split(':')[0], '2xl') }}</span>
                {%- elseif link.url|default -%}
                  {#- website image as icon fallback ~#}
                  {%- set website_image = image_from_website(link.url, {alt: '', loading: 'lazy', width: 50}, {responsive: 'density', fallback: link.fallback|default}) -%}
                  {%- if website_image ~%}
                <span class="button-favicon">{{ website_image|raw }}</span>
                  {%- endif ~%}
                {%- endif ~%}
                {%- if link.title|default ~%}
                <span class="button-title">{{ link.title }}</span>
                {%- endif ~%}
              </div>
              {%- endif ~%}
            </a>
          </li>
          {%- endfor ~%}
        </ol>
        {%- if links|filter(link => link.video|default)|length > 0 ~%}
        <script>
          window.addEventListener('load', () => {
            for (const video of document.querySelectorAll('#{{ prefix }} video')) {
              video.controls = false
              video.addEventListener('mouseover', () => { video.controls = 'controls' })
              video.addEventListener('mouseout', () => { video.controls = false })
            }
          }, false)
        </script>
        {%- endif -%}
      {%- endif ~%}