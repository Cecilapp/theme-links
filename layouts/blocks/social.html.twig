{%- import 'macros/fontawesome.twig' as fontawesome -%}
{%- set social_icons = {
  github: 'github',
  linkedin: 'linkedin',
  instagram: 'instagram',
  youtube: 'youtube',
  mastodon: 'mastodon',
  steam: 'steam',
  bluesky: 'bluesky',
  threads: 'threads',
  twitter: 'twitter',
  x: 'x-twitter',
} -%}
        {#- social identities ~#}
        {%- if site.social|default([]) ~%}
        <div class="social">
          {%- if site.author.email is defined ~%}
          <a href="mailto:{{ site.author.email }}" target="_blank" title="{% trans %}Email me{% endtrans %}">
            <span class="social-icon social-email">{{ fontawesome.icon('envelope', 'regular', '2xl') ~}}</span>
            <span class="sr-only">{% trans %}Email me{% endtrans %}</span>
          </a>
          {%- endif ~%}
          {%- for social_name, social_values in site.social ~%}
            {%- if social_values['url'] is defined ~%}
          <a href="{{ social_values['url'] }}" target="_blank" title="{{ social_name|capitalize }}">
            <span class="social-icon social-{{ social_name }}">{{ fontawesome.icon(social_icons[social_name]|default(social_name), 'brands', '2xl') ~}}</span>
            <span class="sr-only">{{ social_name|capitalize }}</span>
          </a>
            {%- endif ~%}
          {%- endfor ~%}
        </div>
        {%- endif ~%}