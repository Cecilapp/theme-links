{% import 'macros/fontawesome.twig' as fontawesome -%}
<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{- include('partials/metatags.html.twig', {page, site}, with_context = false) ~}}
    <style>
      {{ asset('styles.css')|inline }}
    </style>
    {{- include('partials/fontawesome.twig') ~}}
    {{- include('partials/pwa.html.twig', {site}, with_context = false) ~}}
  </head>
  <body>
    <div class="layout">
      {#- color scheme button ~#}
      <div class="theme-selector">
        {{ include('partials/selector-theme-icon.html.twig') }}
      </div>
      {#- share button ~#}
      <div class="share">
        <button id="share-button" type="button" title="{% trans %}Share{% endtrans %}">
          {{ fontawesome.icon('arrow-up-from-bracket', 'solid', 'lg') ~}}<span class="sr-only">{% trans %}Share{% endtrans %}</span>
        </button>
      </div>
      <header class="header">
        {%- block header ~%}
        {#- avatar ~#}
        {{ html(
          asset(site.avatar|default('avatar.png')),
          attributes={
            width: 128,
            class: 'avatar',
            alt: 'Avatar of %name%'|trans({'%name%': site.title}),
            fetchpriority: 'high'
          },
          options={
            responsive: 'density',
            formats: ['webp']
          }
        ) }}
        {#- name + baseline ~#}
        <h1>
          <div class="site-title">{{ site.title }}</div>
          <div class="site-baseline">{{ site.baseline }}</div>
        </h1>
        {%- endblock header ~%}
      </header>
      <main class="main">
        {%- block main ~%}
        <div class="content">
          {%- block content ~%}
          {{ page.content }}
          {%- endblock content ~%}
        </div>
        {%- endblock main ~%}
      </main>
      <footer class="footer">
        {%- block footer ~%}
        <div class="powered-by">
          {% set powered_by -%}
          <a href="https://links.cecil.app" target="_blank">Cecil Links</a>
          {%- endset -%}
          {%- trans %}Powered by %powered_by%{% endtrans ~%}
        </div>
        {%- endblock footer ~%}
      </footer>
    </div>
    {%- block scripts ~%}
    <script>{% apply minify_js ~%}
      // share button
      const shareButton = document.getElementById('share-button');
      if (navigator.share) {
        shareButton.addEventListener('click', async () => {
          try {
            const shareData = {
              text: '{{ site.title }}',
              url: '{{ url(page, {canonical: true}) }}',
            };
            await navigator.share(shareData);
          } catch (err) {
            console.log('`navigator.share` error:', err);
          }
        });
      } else {
        console.log('`navigator.share` not supported.');
        shareButton.remove();
      }
    {% endapply %}</script>
    {%- endblock scripts ~%}
  </body>
</html>